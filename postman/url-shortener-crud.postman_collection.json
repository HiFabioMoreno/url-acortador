{
  "info": {
    "name": "URL Shortener - Form Login + CRUD",
    "description": "Flujo end-to-end con formLogin de Spring Security: POST /registro/ permite registrar usuarios sin autenticacion ni token CSRF; despues se obtiene el token CSRF desde /login, se inicia sesion y se ejecuta el CRUD de URLs acortadas. Configura loginEmail y loginPassword en el environment antes de ejecutar el CRUD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "loginEmail",
      "value": "",
      "description": "Email del usuario precargado con rol ROLE_USER. Configurar en el environment."
    },
    {
      "key": "loginPassword",
      "value": "",
      "description": "Password del usuario precargado. Configurar en el environment; no guardar credenciales reales en este archivo."
    },
    {
      "key": "registroEmail",
      "value": "",
      "description": "Email del nuevo usuario. Configurar en el environment; no guardar credenciales reales en este archivo."
    },
    {
      "key": "registroPassword",
      "value": "",
      "description": "Password del nuevo usuario. Configurar en el environment; no guardar credenciales reales en este archivo."
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "urlId",
      "value": ""
    },
    {
      "key": "slug",
      "value": ""
    },
    {
      "key": "originalUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Registrar usuario (sin autenticacion)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registro publico 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Usuario creado con ROLE_USER y habilitado', function () {",
              "  pm.expect(body.email).to.eql(pm.collectionVariables.get('registroEmail'));",
              "  pm.expect(body.role).to.eql('ROLE_USER');",
              "  pm.expect(body.enabled).to.be.true;",
              "  pm.expect(body.password).to.be.undefined;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "{{registroEmail}}"
            },
            {
              "key": "password",
              "value": "{{registroPassword}}"
            }
          ]
        },
        "url": "{{baseUrl}}/registro/"
      }
    },
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Obtener CSRF y sesion desde /login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.jar().clear();",
                  "pm.collectionVariables.set('csrfToken', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pagina de login 200', function () { pm.response.to.have.status(200); });",
                  "const q = String.fromCharCode(34);",
                  "const html = pm.response.text();",
                  "const marker = 'name=' + q + '_csrf' + q;",
                  "const valueMarker = 'value=' + q;",
                  "const start = html.indexOf(marker);",
                  "const valueStart = html.indexOf(valueMarker, start);",
                  "const end = html.indexOf(q, valueStart + valueMarker.length);",
                  "const token = valueStart > -1 && end > valueStart ? html.slice(valueStart + valueMarker.length, end) : null;",
                  "pm.test('CSRF token presente', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
                  "if (token) { pm.collectionVariables.set('csrfToken', token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Iniciar sesion (formLogin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login redirige (302)', function () { pm.response.to.have.status(302); });"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{loginEmail}}"
                },
                {
                  "key": "password",
                  "value": "{{loginPassword}}"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrfToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Obtener CSRF autenticado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pagina de login 200', function () { pm.response.to.have.status(200); });",
                  "const q = String.fromCharCode(34);",
                  "const html = pm.response.text();",
                  "const marker = 'name=' + q + '_csrf' + q;",
                  "const valueMarker = 'value=' + q;",
                  "const start = html.indexOf(marker);",
                  "const valueStart = html.indexOf(valueMarker, start);",
                  "const end = html.indexOf(q, valueStart + valueMarker.length);",
                  "const token = valueStart > -1 && end > valueStart ? html.slice(valueStart + valueMarker.length, end) : null;",
                  "pm.test('CSRF token autenticado presente', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
                  "if (token) { pm.collectionVariables.set('csrfToken', token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Verificar sesion activa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Respuesta es arreglo', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acortador/"
          }
        }
      ]
    },
    {
      "name": "CRUD URLs",
      "item": [
        {
          "name": "Crear URL acortada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.collectionVariables.get('loginEmail') || 'postman-user';",
                  "pm.collectionVariables.set('originalUrl', 'https://example.com/postman/' + encodeURIComponent(email) + '/' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creacion 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Respuesta con id y slug', function () {",
                  "  pm.expect(body.idUrl).to.be.a('number');",
                  "  pm.expect(body.slug).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('URL original coincide', function () { pm.expect(body.originalUrl).to.eql(pm.collectionVariables.get('originalUrl')); });",
                  "pm.collectionVariables.set('urlId', body.idUrl);",
                  "pm.collectionVariables.set('slug', body.slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{originalUrl}}\"\n}"
            },
            "url": "{{baseUrl}}/acortador/"
          }
        },
        {
          "name": "Listar URLs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado 200', function () { pm.response.to.have.status(200); });",
                  "const urls = pm.response.json();",
                  "pm.test('Respuesta es arreglo', function () { pm.expect(urls).to.be.an('array'); });",
                  "const urlId = pm.collectionVariables.get('urlId');",
                  "const found = urls.find(u => String(u.idUrl) === String(urlId));",
                  "pm.test('Contiene la URL creada', function () { pm.expect(found).to.be.an('object'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acortador/"
          }
        },
        {
          "name": "Actualizar URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualizacion 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Titulo actualizado', function () { pm.expect(body.titulo).to.eql('Titulo actualizado por Postman'); });",
                  "pm.test('Mismo id', function () { pm.expect(String(body.idUrl)).to.eql(String(pm.collectionVariables.get('urlId'))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Titulo actualizado por Postman\"\n}"
            },
            "url": "{{baseUrl}}/acortador/{{urlId}}/"
          }
        },
        {
          "name": "Redirigir por slug",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Redireccion 302', function () { pm.response.to.have.status(302); });",
                  "pm.test('Location apunta a la URL original', function () {",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql(pm.collectionVariables.get('originalUrl'));",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{slug}}/"
          }
        },
        {
          "name": "Verificar click registrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado 200', function () { pm.response.to.have.status(200); });",
                  "const urls = pm.response.json();",
                  "const urlId = pm.collectionVariables.get('urlId');",
                  "const found = urls.find(u => String(u.idUrl) === String(urlId));",
                  "pm.test('vecesAccedido incrementado', function () { pm.expect(found.vecesAccedido).to.be.at.least(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acortador/"
          }
        },
        {
          "name": "Eliminar URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Eliminacion 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/acortador/{{urlId}}/"
          }
        },
        {
          "name": "Verificar eliminacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado 200', function () { pm.response.to.have.status(200); });",
                  "const urls = pm.response.json();",
                  "const urlId = pm.collectionVariables.get('urlId');",
                  "const found = urls.find(u => String(u.idUrl) === String(urlId));",
                  "pm.test('La URL ya no existe', function () { pm.expect(found).to.be.undefined; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acortador/"
          }
        }
      ]
    },
    {
      "name": "Casos negativos",
      "item": [
        {
          "name": "Crear URL invalida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('URL invalida rechazada (400)', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"ftp://no-es-valida\"\n}"
            },
            "url": "{{baseUrl}}/acortador/"
          }
        },
        {
          "name": "Actualizar URL inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inexistente devuelve 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"No existe\"\n}"
            },
            "url": "{{baseUrl}}/acortador/999999/"
          }
        },
        {
          "name": "Cerrar sesion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout redirige (302)', function () { pm.response.to.have.status(302); });"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_csrf",
                  "value": "{{csrfToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/logout"
          }
        },
        {
          "name": "Acceso sin sesion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sin sesion rechazado (401)', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acortador/"
          }
        }
      ]
    }
  ]
}
